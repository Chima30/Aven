# AVEN environment variables
# Copy names only. Put real values in Vercel (Project → Settings → Environment Variables)
# or in a local .env.local file that is never committed.

# Public (safe to expose to the browser — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server only — NEVER prefix with NEXT_PUBLIC_, never paste into chat or code
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: Walrus Memory (Mainnet). Server only. See docs/WALRUS_SETUP.md
# AVEN works without these; memory features show "not configured".
# ---------------------------------------------------------------------------
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=aven-production
# 32+ random characters, e.g. the output of: openssl rand -hex 32
MEMWAL_NAMESPACE_SECRET=

# ---------------------------------------------------------------------------
# Optional: Tatum Sui Mainnet (read-only). Server only. See docs/TATUM_SETUP.md
# Sui JSON-RPC is deprecated, so AVEN uses Tatum's gRPC gateway by default.
# ---------------------------------------------------------------------------
TATUM_API_KEY=
TATUM_SUI_TRANSPORT=grpc
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443
TATUM_SUI_GRPC_WEB_URL=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
